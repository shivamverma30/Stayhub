<% layout("/layouts/biolerplate") %>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = JSON.parse('<%- JSON.stringify(listing) %>');
</script>

<section class="listing-detail-wrap">
  <div class="detail-header">
    <h1><%= listing.title %></h1>
    <p class="detail-location"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p>
  </div>

  <article class="listing-show-card">
    <div class="listing-hero-wrap">
      <img src="<%= listing.image.url %>" class="show-img" alt="listing_image">
    </div>
    <div class="listing-meta-grid">
      <div class="listing-description">
        <p class="owner-line">Hosted by <strong><%= listing.owner.username %></strong></p>
        <p><%= listing.description %></p>
      </div>
      <aside class="price-highlight">
        <span class="price-value">&#8377; <%= listing.price.toLocaleString("en-IN") %></span>
        <span>per night</span>
      </aside>
    </div>
  </article>

  <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
    <div class="btns detail-action-row">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">Edit Listing</a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-outline-dark">Delete</button>
      </form>
    </div>
  <% } %>

  <section class="review-section">
    <% if(currUser){ %>
      <div class="review-form-card">
        <h4>Leave a review</h4>
        <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation review-form">
          <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label>
            <fieldset class="starability-slot">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>

          <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
            <div class="invalid-feedback">Please add some comments for review</div>
          </div>
          <button class="btn btn-dark px-4">Submit review</button>
        </form>
      </div>
    <% } %>

    <% if(listing.reviews.length > 0) {%>
      <div class="reviews-list-wrap">
        <h4>Guest reviews</h4>
        <div class="row g-3">
          <% for (review of listing.reviews) { %>
            <div class="col-lg-6">
              <div class="card review-card h-100">
                <div class="card-body">
                  <h5 class="card-title">@<%= review.author ? review.author.username : "Unknown User" %></h5>
                  <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                  <p class="card-text mb-0"><%= review.comment %></p>
                </div>
                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="review-delete-form">
                  <button class="btn btn-sm btn-outline-dark">Delete</button>
                </form>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>
  </section>

  <section class="map-wrap">
    <h3>Where you'll be</h3>
    <div id="map"></div>
  </section>
</section>
<script src="/js/map.js"></script>
