<% layout("/layouts/biolerplate") %>
<section class="form-screen-wrap">
  <div class="form-card listing-form-card">
    <div class="form-head">
      <h1>Create a New Listing</h1>
      <p>Share your space with travelers and start hosting.</p>
    </div>

    <form method="POST" action="/listings" novalidate class="needs-validation premium-form" enctype="multipart/form-data">
      <div class="form-floating mb-3">
        <input name="listing[title]" placeholder="Add a catchy title" type="text" class="form-control" id="title" required />
        <label for="title">Title</label>
        <div class="valid-feedback">Title looks good</div>
      </div>

      <div class="form-floating mb-3">
        <textarea name="listing[description]" class="form-control floating-textarea" placeholder="Describe your place" id="description" required></textarea>
        <label for="description">Description</label>
        <div class="invalid-feedback">Please enter a short description</div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Upload Image</label>
        <input name="listing[image]" type="file" class="form-control" id="image" required />
      </div>

      <div class="row g-3">
        <div class="col-md-4">
          <div class="form-floating">
            <input name="listing[price]" placeholder="1200" class="form-control" id="price" required/>
            <label for="price">Price</label>
            <div class="invalid-feedback">Please enter a valid price</div>
          </div>
        </div>

        <div class="col-md-8">
          <div class="form-floating">
            <input name="listing[country]" placeholder="India" type="text" class="form-control" id="country" required/>
            <label for="country">Country</label>
            <div class="invalid-feedback">Country name should be valid</div>
          </div>
        </div>
      </div>

      <div class="form-floating mb-3 mt-3">
        <input class="form-control" name="listing[location]" placeholder="BBK, Lucknow" type="text" id="location" required/>
        <label for="location">Location</label>
        <div class="invalid-feedback">Location name should be valid</div>
      </div>

      <button class="btn btn-dark add-btn mt-2">Publish Listing</button>
    </form>
  </div>
</section>

