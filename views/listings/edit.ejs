<% layout("/layouts/biolerplate") %>
<section class="form-screen-wrap">
  <div class="form-card listing-form-card">
    <div class="form-head">
      <h1>Edit your Listing</h1>
      <p>Update details and keep your listing fresh.</p>
    </div>

    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation premium-form" enctype="multipart/form-data">
      <div class="form-floating mb-3">
        <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" id="title" required />
        <label for="title">Title</label>
        <div class="invalid-feedback">Please enter a suitable title</div>
      </div>

      <div class="form-floating mb-3">
        <textarea name="listing[description]" class="form-control floating-textarea" id="description" required><%= listing.description %></textarea>
        <label for="description">Description</label>
        <div class="invalid-feedback">Please enter a short description</div>
      </div>

      <div class="mb-3 existing-image-wrap">
        <p class="mb-2">Original Listing Image</p>
        <img src="<%= originalImageUrl %>" alt="Original listing image" class="existing-listing-image" >
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Upload New Image</label>
        <input name="listing[image]" type="file" class="form-control" id="image"/>
      </div>

      <div class="row g-3">
        <div class="col-md-4">
          <div class="form-floating">
            <input name="listing[price]" value="<%= listing.price %>" type="number" class="form-control" id="price" required/>
            <label for="price">Price</label>
            <div class="invalid-feedback">Please enter a valid price</div>
          </div>
        </div>

        <div class="col-md-8">
          <div class="form-floating">
            <input name="listing[country]" value="<%= listing.country %>" type="text" class="form-control" id="country" required/>
            <label for="country">Country</label>
            <div class="invalid-feedback">Please enter a valid country</div>
          </div>
        </div>
      </div>

      <div class="form-floating mb-3 mt-3">
        <input name="listing[location]" value="<%= listing.location %>" type="text" class="form-control" id="location" required />
        <label for="location">Location</label>
        <div class="invalid-feedback">Please enter a valid location</div>
      </div>

      <button class="btn btn-dark edit-btn mt-2">Save Changes</button>
    </form>
  </div>
</section>
